# ── Variables para docker-compose ────────────────────────
# Copia este archivo a  .env  y cambia TODOS los valores marcados.

# Puerto público del servidor (lo que verá el navegador / el reverse proxy)
APP_PORT=4000

# Base de datos
DB_NAME=metrologia
DB_USER=metrologia_app
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_LARGA

# Seguridad JWT — genera una cadena larga y aleatoria:
#   openssl rand -base64 48
JWT_SECRET=CAMBIA_POR_UNA_CADENA_LARGA_Y_ALEATORIA
JWT_EXPIRES_IN=8h

# Dominio del frontend (para CORS). Con el reverse proxy suele ser el mismo dominio.
FRONTEND_URL=https://metrologia.tudominio.com
