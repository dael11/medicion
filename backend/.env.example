# ── Servidor ──────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── Base de datos PostgreSQL ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metrologia
DB_USER=metrologia_app
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA

# ── Seguridad (JWT) ───────────────────────────────────────
# Genera una cadena larga y aleatoria, p.ej.:  openssl rand -base64 48
JWT_SECRET=CAMBIA_POR_UNA_CADENA_LARGA_Y_ALEATORIA
JWT_EXPIRES_IN=8h

# ── CORS ──────────────────────────────────────────────────
# Dominio del frontend. Si el backend sirve el frontend, usa el mismo dominio.
FRONTEND_URL=https://metrologia.tudominio.com

# ── Frontend (opcional) ───────────────────────────────────
# Ruta al build de React. Por defecto ../frontend/build
# FRONTEND_DIR=/ruta/absoluta/al/frontend/build
